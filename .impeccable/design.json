      "css": ".ds-pstrip{display:flex;align-items:center;gap:8px;height:52px;padding:0 16px;background:#111}.ds-ptag{position:relative;display:inline-flex;align-items:baseline;height:34px;padding:7px 14px 0 22px;font-family:Anton,Impact,sans-serif;font-size:.98rem;line-height:1.2;letter-spacing:.04em;text-transform:uppercase;color:#111;text-decoration:none;isolation:isolate;white-space:nowrap}.ds-ptag::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--t);clip-path:polygon(12px 0,100% 0,100% 100%,12px 100%,0 50%);transform:translate(2px,-1px);transition:transform 90ms steps(2,jump-none)}.ds-ptag::after{content:'';position:absolute;left:9px;top:50%;width:6px;height:6px;margin-top:-3px;border-radius:50%;background:#111}.ds-ptag:hover::before{transform:translate(5px,-4px)}.ds-ptag:active::before{transform:none}.ds-ptag:focus-visible{outline:3px solid #111;outline-offset:4px;box-shadow:0 0 0 4px #ffd400}"
