      "css": ".ds-ticket{display:grid;grid-template-rows:auto 1fr auto;width:156px;height:78px;padding:7px 16px 8px 18px;background:#e3d3a8;color:#1a1814;text-decoration:none;transform:rotate(-2deg);-webkit-mask:radial-gradient(circle at 0 50%,transparent 4px,#000 4.5px) left/51% 12px repeat-y,radial-gradient(circle at 100% 50%,transparent 4px,#000 4.5px) right/51% 12px repeat-y;mask:radial-gradient(circle at 0 50%,transparent 4px,#000 4.5px) left/51% 12px repeat-y,radial-gradient(circle at 100% 50%,transparent 4px,#000 4.5px) right/51% 12px repeat-y;transition:transform 150ms steps(2,end)}.ds-ticket:hover{transform:rotate(1deg) translateY(-2px)}.ds-ticket:focus-visible{outline:3px solid #d22b1f;outline-offset:3px}.ds-t-no{font-family:'Special Elite',monospace;font-size:.75rem}.ds-t-name{font-family:'Archivo Black',sans-serif;font-size:1rem;align-self:center}.ds-t-yr{font-family:'Old Standard TT',serif;font-style:italic;font-size:.8rem}"
