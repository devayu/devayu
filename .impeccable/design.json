  "components": [
    {
      "name": "Gallery Canvas",
      "kind": "card",
      "description": "A lit canvas on the night wall; widens and performs its movement on hover or focus.",
      "html": "<div class=\"ds-wall\"><a class=\"ds-room\" href=\"#\"><span class=\"ds-room-art\"></span><span class=\"ds-room-label\"><span class=\"ds-room-name\">bauhaus</span><span class=\"ds-room-years\">1919–1933</span></span></a><a class=\"ds-room ds-room-b\" href=\"#\"><span class=\"ds-room-art\"></span></a></div>",
      "css": ".ds-wall{display:flex;gap:10px;height:280px;padding:16px;background:#0f0e0d}.ds-room{position:relative;flex:1 1 0;overflow:hidden;background:#ede7d9;color:#161514;text-decoration:none;box-shadow:0 34px 60px -34px rgb(0 0 0/.9);transition:flex-grow 760ms cubic-bezier(.16,1,.3,1),filter 500ms ease-out}.ds-room::after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 60% at 50% -10%,rgb(255 250 235/.14),transparent 60%)}.ds-room-art{position:absolute;left:22px;top:0;bottom:0;width:14px;background:#d0331f}.ds-room-b{background:#e8dcc4}.ds-room-b .ds-room-art{background:#c9a15f;left:30%;width:40%;top:20%;bottom:30%}.ds-room-label{position:absolute;left:36px;bottom:0;display:grid;gap:6px;padding:20px 22px 22px}.ds-room-name{font-family:Archivo,sans-serif;font-stretch:125%;font-weight:700;font-size:2.4rem;line-height:.9;letter-spacing:-.03em}.ds-room-years{font-family:Jost,sans-serif;font-weight:500;font-size:.875rem}.ds-wall:hover .ds-room{flex-grow:.75}.ds-wall .ds-room:hover{flex-grow:2.3;filter:none}.ds-wall:hover .ds-room:not(:hover){filter:saturate(.6) brightness(.62)}.ds-room:focus-visible{outline:2px solid #efe9dc;outline-offset:4px}"
