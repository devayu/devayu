      "css": ".ds-facet{display:inline-block;margin:24px;color:#1f1d1a;text-decoration:none;--face:#c9a15f;--face-lit:#dcbb7f}.ds-facet-face{position:relative;display:inline-flex;align-items:center;padding:.95em 1.5em .9em 1.75em;background:var(--face);font-family:'Big Shoulders Stencil',sans-serif;font-weight:800;font-size:15px;letter-spacing:.16em;line-height:1;text-transform:uppercase;clip-path:polygon(3% 0,100% 7%,97% 100%,0 90%);transition:background-color 150ms steps(1,end),translate 150ms steps(1,end)}.ds-facet-face::before,.ds-facet-face::after{content:'';position:absolute;top:0;bottom:0;width:11px;background:repeating-linear-gradient(35deg,rgba(42,38,34,.82) 0 1.3px,transparent 1.3px 5.5px);transition:opacity 150ms steps(1,end)}.ds-facet-face::before{left:0}.ds-facet-face::after{right:0;opacity:0}.ds-facet:hover .ds-facet-face,.ds-facet:focus-visible .ds-facet-face{background:var(--face-lit)}.ds-facet:hover .ds-facet-face::before,.ds-facet:focus-visible .ds-facet-face::before{opacity:0}.ds-facet:hover .ds-facet-face::after,.ds-facet:focus-visible .ds-facet-face::after{opacity:1}.ds-facet:active .ds-facet-face{translate:2px 1px}.ds-facet:focus-visible{outline:3px solid #2a2622;outline-offset:4px}"
